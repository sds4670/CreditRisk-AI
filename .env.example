# CreditRisk AI Environment Variables Example
# Copy this file to .env for local configuration

# Optional API Key Authentication
# If CREDITRISK_API_KEY is unset, authentication is disabled for local development.
# If configured, requests to protected API endpoints (/score, /portfolio-summary, /model-info)
# must include the header:  X-API-Key: your_secure_api_key_here
CREDITRISK_API_KEY=your_secure_api_key_here

# Server Port Configuration (Render / Production)
PORT=8000
